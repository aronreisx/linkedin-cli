  "cards": [
    {
      "dot": "cyan",
      "title": "Composition Root & Terminal UX",
      "items": [
        "src/main.rs parses CLI commands with Clap, routing to domain traits with zero domain logic in the root",
        "Ratatui interactive split-pane TUI provides keyboard-driven inbox and draft views",
        "Streaming NDJSON and clean Unix stdout/stderr channel separation with graceful SIGPIPE exit handling"
      ]
    },
    {
      "dot": "violet",
      "title": "Local Staging & Storage Engine",
      "items": [
        "SqliteDraftStore provides embedded persistence for drafts via rusqlite with lifecycle state transitions",
        "Post draft hierarchy (post draft add/list/export) organizes local staging and automation schedule exports",
        "KeyringCredentialStore protects credentials via OS Keyring, isolating browser sessions per profile"
      ]
    },
    {
      "dot": "emerald",
      "title": "Browser Lifecycle & Stealth Protection",
      "items": [
        "BrowserSession manages Chromium process lifecycle with clean SIGINT/SIGTERM termination traps",
        "CDP stealth script injection shims navigator.webdriver, window.chrome, WebGL vendor/renderer, and plugins",
        "Strict sandbox directory isolation ensures zero cross-profile cookie or storage leakage"
      ]
    },
    {
      "dot": "amber",
      "title": "Behavioral Dynamics & Anti-Bot Safeguards",
      "items": [
        "Gaussian human typing engine emulates physical key events, Box-Muller delays, cognitive pauses, and typo correction",
        "Tripwire circuit breaker detects /checkpoint/, CAPTCHA challenges, and anti-bot lockouts, halting automation",
        "Randomized dispatch jitter (45s–120s) and pairwise template variance checks prevent account flagging"
      ]
    },
    {
      "dot": "rose",
      "title": "Domain Core & Analytics Engine",
      "items": [
        "Pure async traits and entities in src/domain/ remain completely decoupled from chromiumoxide",
        "Voyager analytics schema mapping computes impressions, CTR %, and demographic breakdown",
        "PageState FSM classifies page status purely by URL path, immune to query parameter deception"
      ]
    }
  ]
